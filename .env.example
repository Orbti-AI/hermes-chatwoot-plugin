# Chatwoot Agent Bot platform plugin — per-profile config.
#
# One hermes profile == one Chatwoot Agent Bot == one account_id. Set these
# in the hermes profile's own .env (e.g. /data/.hermes/profiles/<profile>/.env
# on a Railway-style deploy, or ~/.hermes/profiles/<profile>/.env locally) —
# never as a machine-wide/service-level variable, since each profile talks to
# a different bot/account.

# Base URL of the Chatwoot instance, no trailing slash.
CHATWOOT_BASE_URL=https://chat.example.com

# The Agent Bot's own access_token (Chatwoot -> Settings -> Agent Bots ->
# this bot), NOT a personal user api_access_token — keeps replies attributed
# to the bot rather than a human agent.
CHATWOOT_BOT_API_KEY=

# The Chatwoot account_id this bot belongs to (the number in the account URL,
# e.g. https://chat.example.com/app/accounts/2/... -> 2).
CHATWOOT_ACCOUNT_ID=

# --- Optional -----------------------------------------------------------
# Host/port the webhook server binds to. Defaults shown below — override
# only if 9000 is already taken by something else on this machine/container.
# CHATWOOT_WEBHOOK_HOST=0.0.0.0
# CHATWOOT_WEBHOOK_PORT=9000
